<UserControl x:Class="IPtor.Views.PersonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="ScrollViewer">
            <Setter Property="CanContentScroll" Value="False"/>
        </Style>
        <Style TargetType="TextBox">
            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
        </Style>
        <!--<Style TargetType="ScrollViewer">
        <Setter Property="PanningMode" Value="VerticalOnly"/>
        <Setter Property="PanningDeceleration" Value="0.01"/>
        <Setter Property="PanningRatio" Value="0.01"/>
    </Style>-->
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <WrapPanel>
                <Button Content="🔄" ToolTip="Обновить" Command="{Binding LoadPersonsCommand}"
                Width="35" Height="30" Margin="0,0,5,0" />
                <Button Content="🗑" ToolTip="Удалить" Command="{Binding DeletePersonCommand}"
                Width="35" Height="30" Margin="0,0,10,0" />

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                 Width="200" Height="30" Margin="0,0,5,0"
                 VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="🔍" ToolTip="Поиск" Command="{Binding SearchCommand}"
                Width="35" Height="30" />
            </WrapPanel>
        </StackPanel>

        <!-- Список сотрудников -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Persons}"
                 SelectedItem="{Binding SelectedPerson}"
                 MouseDoubleClick="ListBox_MouseDoubleClick"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,2" Background="#F8F8F8" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                                <TextBlock Text="{Binding Position}" Foreground="Gray" />
                                <TextBlock Text="{Binding Rank}" FontSize="12" Foreground="#666" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Service}"
                                       VerticalAlignment="Center"
                                       Foreground="#007ACC"
                                       FontWeight="Bold" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Форма добавления -->
        <Border Grid.Row="2" Background="#F0F4F8" Padding="15" Margin="0,10,0,0" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Добавить сотрудника" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />

                <WrapPanel Grid.Row="1">
                    <StackPanel Margin="0,0,10,5" Width="200">
                        <TextBlock Text="ФИО" FontSize="11" Foreground="Gray" />
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,10,5" Width="150">
                        <TextBlock Text="Должность" FontSize="11" Foreground="Gray" />
                        <TextBox Text="{Binding NewPosition, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,10,5" Width="120">
                        <TextBlock Text="Звание" FontSize="11" Foreground="Gray" />
                        <TextBox Text="{Binding NewRank, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,10,5" Width="150">
                        <TextBlock Text="Группа" FontSize="11" Foreground="Gray" />
                        <TextBox Text="{Binding NewUndPosition, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,10,5" Width="120">
                        <TextBlock Text="Служба" FontSize="11" Foreground="Gray" />
                        <ComboBox ItemsSource="{Binding ServiceTypes}"
                                  SelectedItem="{Binding NewService}" />
                    </StackPanel>
                </WrapPanel>

                <Button Grid.Row="2"
                        Content="➕ Добавить"
                        Command="{Binding AddPersonCommand}"
                        Padding="15,8"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand" />
            </Grid>
        </Border>
    </Grid>
</UserControl>