<Window x:Class="IPtor.Views.TOActView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Акт технического состояния" 
        WindowStartupLocation="CenterOwner"
        Height="750" Width="550"
        Background="#2D2D30">

    <Window.Resources>
        <Style TargetType="TextBox">
            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Информация об автомобиле -->
        <Border Grid.Row="0" Background="#3E3E42" Padding="8" Margin="0,0,0,6" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Информация об автомобиле" FontSize="14" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding CarInfo}" FontSize="12" Foreground="#CCCCCC"/>
            </StackPanel>
        </Border>

        <!-- Ответственные лица и показатели -->
        <GroupBox Grid.Row="1" Header="Общие данные" Margin="0,0,0,6" Padding="4"
                  Foreground="White" BorderBrush="#555">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="35*"/>
                    <ColumnDefinition Width="309*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Начальник службы:" 
                           VerticalAlignment="Center" Margin="2,0,2,0" FontWeight="Bold" FontSize="11" Foreground="#CCC"/>
                <ComboBox IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" StaysOpenOnEdit="True"
                          Grid.Row="0" Grid.Column="1" 
                          ItemsSource="{Binding Persons}"
                          SelectedItem="{Binding SheffPassService}"
                          Margin="2,0,2,0" Height="24" FontSize="11"
                          Background="#3E3E42" Grid.ColumnSpan="2">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="Background" Value="White" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                <TextBlock Text="{Binding Position}" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Row="0" Grid.Column="3" Content="+" Command="{Binding AddPersonCommand}"
                        Width="24" Height="24" Margin="3,0,3,0" FontSize="12" FontWeight="Bold"
                        Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ответственное лицо:" 
                           VerticalAlignment="Center" Margin="2,0,2,0" FontWeight="Bold" FontSize="11" Foreground="#CCC"/>
                <ComboBox IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" StaysOpenOnEdit="True"
                          Grid.Row="1" Grid.Column="1" 
                          ItemsSource="{Binding Persons}"
                          SelectedItem="{Binding ResponcePerson}"
                          Margin="2,0,2,0" Height="24" FontSize="11"
                          Background="#3E3E42" Grid.ColumnSpan="2">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="Background" Value="White" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                <TextBlock Text="{Binding Position}" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Row="1" Grid.Column="3" Content="+" Command="{Binding AddPersonCommand}"
                        Width="24" Height="24" Margin="3,0,3,0" FontSize="12" FontWeight="Bold"
                        Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Водитель:" 
                           VerticalAlignment="Center" Margin="2,0,2,0" FontWeight="Bold" FontSize="11" Foreground="#CCC"/>
                <ComboBox IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" StaysOpenOnEdit="True"
                          Grid.Row="2" Grid.Column="1" 
                          ItemsSource="{Binding Persons}"
                          SelectedItem="{Binding Driver}"
                          Margin="2,0,2,0" Height="24" FontSize="11"
                          Background="#3E3E42" Grid.ColumnSpan="2">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="Background" Value="White" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                <TextBlock Text="{Binding Position}" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Row="2" Grid.Column="3" Content="+" Command="{Binding AddPersonCommand}"
                        Width="24" Height="24" Margin="3,0,3,0" FontSize="12" FontWeight="Bold"
                        Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Километры:" 
                           VerticalAlignment="Center" Margin="2,0,2,0" FontWeight="Bold" FontSize="11" Foreground="#CCC"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding KmSpeedometrStart}" 
                         Margin="2,0,2,0" Height="22" FontSize="11" Background="#3E3E42" Foreground="White" Grid.ColumnSpan="2"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Моточасы:" 
                           VerticalAlignment="Center" Margin="2,0,2,0" FontWeight="Bold" FontSize="11" Foreground="#CCC"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MhSpeedStart}" 
                         Margin="2,0,2,0" Height="22" FontSize="11" Background="#3E3E42" Foreground="White" Grid.ColumnSpan="2"/>
            </Grid>
        </GroupBox>

        <!-- Техническое состояние и укомплектованность -->
        <GroupBox Grid.Row="2" Header="Техническое состояние и укомплектованность" Margin="0,0,0,6" Padding="4"
          Foreground="White" BorderBrush="#555">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="350">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Тех. состояние -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Кузов (корпус):" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Body}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Кабина:" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HeadBody}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Двигатель:" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Engine}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="КПП:" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding KPP}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Рулевое управление:" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Rul}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Передний мост:" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding FrontGear}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Задний мост:" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding BackGear}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Электрооборудование:" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Electro}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Отсеки ПТВ:" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding PTV}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Водопенные коммуникации:" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Water}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Внешний вид:" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding GeneralView}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Спец. оборудование:" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Spec}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Тормозная система:" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding Break}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="13" Grid.Column="0" Text="Прочее:" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="13" Grid.Column="1" Text="{Binding Other}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <!-- Укомплектованность -->
                    <TextBlock Grid.Row="14" Grid.Column="0" Text="Пусковая рукоятка:" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="14" Grid.Column="1" Text="{Binding PuskRuk}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="15" Grid.Column="0" Text="Домкрат:" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="15" Grid.Column="1" Text="{Binding Domkrat}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="16" Grid.Column="0" Text="Насос, манометр, лопатка:" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="16" Grid.Column="1" Text="{Binding Nasos}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="17" Grid.Column="0" Text="Шприц рычажно-плунжерный:" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="17" Grid.Column="1" Text="{Binding SHpric}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="18" Grid.Column="0" Text="Молоток слесарный:" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="18" Grid.Column="1" Text="{Binding Molotok}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="19" Grid.Column="0" Text="Плоскогубцы, отвертка, зубило:" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="19" Grid.Column="1" Text="{Binding Ploskogubci}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="20" Grid.Column="0" Text="Ключи накидные:" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="20" Grid.Column="1" Text="{Binding Kluchi}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="21" Grid.Column="0" Text="Ключи плоские двусторонние:" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="21" Grid.Column="1" Text="{Binding Cluchi2}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="22" Grid.Column="0" Text="Ключ торцовый для гаек колес:" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="22" Grid.Column="1" Text="{Binding Cluchi3}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="23" Grid.Column="0" Text="Ключ свечной в сборе:" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="23" Grid.Column="1" Text="{Binding Cluchi4}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="24" Grid.Column="0" Text="Чехлы для сидений:" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="24" Grid.Column="1" Text="{Binding Chehli}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="25" Grid.Column="0" Text="Аптечка:" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="25" Grid.Column="1" Text="{Binding Aptechka}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="26" Grid.Column="0" Text="Знак аварийной остановки:" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="26" Grid.Column="1" Text="{Binding Znak}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="27" Grid.Column="0" Text="Диск запасного колеса:" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="27" Grid.Column="1" Text="{Binding Disk}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="28" Grid.Column="0" Text="Огнетушитель:" 
                       VerticalAlignment="Top" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="28" Grid.Column="1" Text="{Binding Ognetush}" Margin="2,0" Height="35" 
                     TextWrapping="Wrap" AcceptsReturn="True" FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="29" Grid.Column="0" Text="Радиостанция:" 
                       VerticalAlignment="Top" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="29" Grid.Column="1" Text="{Binding Radio}" Margin="2,0" Height="35" 
                     TextWrapping="Wrap" AcceptsReturn="True" FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="30" Grid.Column="0" Text="Противоугонное устройство:" 
                       VerticalAlignment="Top" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="30" Grid.Column="1" Text="{Binding Protivougon}" Margin="2,0" Height="35" 
                     TextWrapping="Wrap" AcceptsReturn="True" FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="31" Grid.Column="0" Text="Громкоговорящая установка:" 
                       VerticalAlignment="Top" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="31" Grid.Column="1" Text="{Binding Gromkogov}" Margin="2,0" Height="35" 
                     TextWrapping="Wrap" AcceptsReturn="True" FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="32" Grid.Column="0" Text="Противотуманные фары:" 
                       VerticalAlignment="Top" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="32" Grid.Column="1" Text="{Binding Protivotuman}" Margin="2,0" Height="35" 
                     TextWrapping="Wrap" AcceptsReturn="True" FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="33" Grid.Column="0" Text="Проблесковый маяк:" 
                       VerticalAlignment="Top" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="33" Grid.Column="1" Text="{Binding Mayak}" Margin="2,0" Height="35" 
                     TextWrapping="Wrap" AcceptsReturn="True" FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="34" Grid.Column="0" Text="Фара-искатель:" 
                       VerticalAlignment="Top" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="34" Grid.Column="1" Text="{Binding Fara}" Margin="2,0" Height="35" 
                     TextWrapping="Wrap" AcceptsReturn="True" FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="35" Grid.Column="0" Text="Прочее:" 
                       VerticalAlignment="Top" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="35" Grid.Column="1" Text="{Binding Prochee}" Margin="2,0" Height="35" 
                     TextWrapping="Wrap" AcceptsReturn="True" FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <!-- Топливо, заключение, предложения -->
                    <TextBlock Grid.Row="36" Grid.Column="0" Text="Наличие топлива (л):" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="36" Grid.Column="1" Text="{Binding Fuel}" Margin="2,0" Height="22" 
                     Width="70" HorizontalAlignment="Left" FontSize="11" 
                     Background="#3E3E42" Foreground="White"
                     PreviewTextInput="FuelValidationTextBox"/>

                    <TextBlock Grid.Row="37" Grid.Column="0" Text="Заключение:" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="37" Grid.Column="1" Text="{Binding Zakl}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="38" Grid.Column="0" Text="Предложения:" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="38" Grid.Column="1" Text="{Binding Pred}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>
                </Grid>
            </ScrollViewer>
        </GroupBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Сформировать акт" Command="{Binding GenerateCommand}"
                    Width="140" Height="30" Margin="4"
                    Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Отмена" Click="Cancel_Click"
                    Width="90" Height="30" Margin="4"
                    Background="#555" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>