<Window x:Class="IPtor.Views.TransferActView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Акт передачи" 
        WindowStartupLocation="CenterOwner"
        Height="700" Width="500"
        Background="#2D2D30">
    <Window.Resources>
        <!-- Стиль для всех TextBox: выделять текст при фокусе -->
        <Style TargetType="TextBox">
            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
        </Style>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Информация об автомобиле -->
        <Border Grid.Row="0" Background="#3E3E42" Padding="8" Margin="0,0,0,6" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Информация об автомобиле" FontSize="14" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding CarInfo}" FontSize="12" Foreground="#CCCCCC"/>
            </StackPanel>
        </Border>

        <!-- Ответственные лица -->
        <GroupBox Grid.Row="1" Header="Ответственные лица" Margin="0,0,0,6" Padding="4"
                  Foreground="White" BorderBrush="#555">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Начальник службы:" 
                           VerticalAlignment="Center" Margin="2,0" FontWeight="Bold" FontSize="11" Foreground="#CCC"/>
                <ComboBox IsEditable="True"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="Name"
                          StaysOpenOnEdit="True"
                          Grid.Row="0" Grid.Column="1" 
                          ItemsSource="{Binding Persons}"
                          SelectedItem="{Binding SheffPassService}"
                          Margin="2,0" Height="24" FontSize="11"
                          Background="#3E3E42" Foreground="Black">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="Background" Value="White" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                <TextBlock Text="{Binding Position}" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Row="0" Grid.Column="2" Content="+" Command="{Binding AddPersonCommand}"
                        Width="24" Height="24" Margin="2,0" FontSize="12" FontWeight="Bold"
                        Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ответственное лицо:" 
                           VerticalAlignment="Center" Margin="2,0" FontWeight="Bold" FontSize="11" Foreground="#CCC"/>
                <ComboBox IsEditable="True"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="Name"
                          StaysOpenOnEdit="True"
                          Grid.Row="1" Grid.Column="1" 
                          ItemsSource="{Binding Persons}"
                          SelectedItem="{Binding ResponcePerson}"
                          Margin="2,0" Height="24" FontSize="11"
                          Background="#3E3E42" Foreground="Black">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="Background" Value="White" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                <TextBlock Text="{Binding Position}" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Row="1" Grid.Column="2" Content="+" Command="{Binding AddPersonCommand}"
                        Width="24" Height="24" Margin="2,0" FontSize="12" FontWeight="Bold"
                        Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Водитель:" 
                           VerticalAlignment="Center" Margin="2,0" FontWeight="Bold" FontSize="11" Foreground="#CCC"/>
                <ComboBox IsEditable="True"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="Name"
                          StaysOpenOnEdit="True"
                          Grid.Row="2" Grid.Column="1" 
                          ItemsSource="{Binding Persons}"
                          SelectedItem="{Binding Driver}"
                          Margin="2,0" Height="24" FontSize="11"
                          Background="#3E3E42" Foreground="Black">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="Background" Value="White" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                <TextBlock Text="{Binding Position}" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Row="2" Grid.Column="2" Content="+" Command="{Binding AddPersonCommand}"
                        Width="24" Height="24" Margin="2,0" FontSize="12" FontWeight="Bold"
                        Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Принимающий:" 
                           VerticalAlignment="Center" Margin="2,0" FontWeight="Bold" FontSize="11" Foreground="#CCC"/>
                <ComboBox IsEditable="True"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="Name"
                          StaysOpenOnEdit="True"
                          Grid.Row="3" Grid.Column="1" 
                          ItemsSource="{Binding Persons}"
                          SelectedItem="{Binding AcceptUtoPerson}"
                          Margin="2,0" Height="24" FontSize="11"
                          Background="#3E3E42" Foreground="Black">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="Background" Value="White" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                <TextBlock Text="{Binding Position}" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Row="3" Grid.Column="2" Content="+" Command="{Binding AddPersonCommand}"
                        Width="24" Height="24" Margin="2,0" FontSize="12" FontWeight="Bold"
                        Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Представитель УТО:" 
                           VerticalAlignment="Center" Margin="2,0" FontWeight="Bold" FontSize="11" Foreground="#CCC"/>
                <ComboBox IsEditable="True"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="Name"
                          StaysOpenOnEdit="True"
                          Grid.Row="4" Grid.Column="1" 
                          ItemsSource="{Binding Persons}"
                          SelectedItem="{Binding AdditionalPerson}"
                          Margin="2,0" Height="24" FontSize="11"
                          Background="#3E3E42" Foreground="Black">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="Background" Value="White" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                                <TextBlock Text="{Binding Position}" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Row="4" Grid.Column="2" Content="+" Command="{Binding AddPersonCommand}"
                        Width="24" Height="24" Margin="2,0" FontSize="12" FontWeight="Bold"
                        Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </GroupBox>
        <!-- Данные по эксплуатации -->
        <GroupBox Grid.Row="2" Header="Данные по эксплуатации" Margin="0,0,0,6" Padding="4"
          Foreground="White" BorderBrush="#555">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовки -->
                <Border Grid.Row="0" Grid.Column="1" Background="#555" Padding="2" Margin="1">
                    <TextBlock Text="Километры" FontWeight="Bold" FontSize="10" TextAlignment="Center" Foreground="White"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Background="#555" Padding="2" Margin="1">
                    <TextBlock Text="Моточасы" FontWeight="Bold" FontSize="10" TextAlignment="Center" Foreground="White"/>
                </Border>

                <!-- Текущие показатели -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Текущие:" VerticalAlignment="Center" 
                   Margin="2,0" FontWeight="Bold" FontSize="10" Foreground="#CCC"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding KmSpeedStart}" 
                 Margin="1" Width="70" Height="22" HorizontalAlignment="Left" FontSize="11"
                 Background="#3E3E42" Foreground="White"/>
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding MhSpeedStart}" 
                 Margin="1" Width="70" Height="22" HorizontalAlignment="Left" FontSize="11"
                 Background="#3E3E42" Foreground="White"/>

                <!-- Средние ремонты -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ср. ремонтов:" VerticalAlignment="Center" 
                   Margin="2,0" FontSize="10" Foreground="#CCC"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AvarageRepair}" 
                 Margin="1" Width="70" Height="22" HorizontalAlignment="Left" FontSize="11"
                 Background="#3E3E42" Foreground="White"/>

                <!-- Кап. ремонты -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Кап. ремонтов:" VerticalAlignment="Center" 
                   Margin="2,0" FontSize="10" Foreground="#CCC"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding KapRepair}" 
                 Margin="1" Width="70" Height="22" HorizontalAlignment="Left" FontSize="11"
                 Background="#3E3E42" Foreground="White"/>

                <!-- Показания при последнем ремонте -->
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Background="#3E3E42" 
                Padding="2" Margin="0,3,0,2" CornerRadius="2">
                    <TextBlock Text="Показания при последнем КР/СР" FontWeight="Bold" FontSize="9" 
                       TextAlignment="Center" Foreground="#CCC"/>
                </Border>

                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding KmSpeedKarRepair}" 
                 Margin="1" Width="70" Height="22" HorizontalAlignment="Left" FontSize="11"
                 Background="#3E3E42" Foreground="White"/>
                <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding MhSpeedKapRepair}" 
                 Margin="1" Width="70" Height="22" HorizontalAlignment="Left" FontSize="11"
                 Background="#3E3E42" Foreground="White"/>
            </Grid>
        </GroupBox>

        <!-- Неисправности -->
        <GroupBox Grid.Row="3" Header="Техническое состояние и неисправности" Margin="0,0,0,6" Padding="4"
          Foreground="White" BorderBrush="#555">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="180">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Укомплектованность:" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Staff}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Двигатель:" VerticalAlignment="Center" 
                       Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EngineDefect}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Электрооборудование:" VerticalAlignment="Center" 
                       Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Electro}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Сцепление:" VerticalAlignment="Center" 
                       Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Clutch}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Коробка передач:" VerticalAlignment="Center" 
                       Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Kpp}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Рулевое управление:" VerticalAlignment="Center" 
                       Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Steering}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Передний мост:" VerticalAlignment="Center" 
                       Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding FrontGear}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Задний мост:" VerticalAlignment="Center" 
                       Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding BackGear}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Рама:" VerticalAlignment="Center" 
                       Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Frame}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Кузов:" VerticalAlignment="Center" 
                       Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Body}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Спецоборудование:" VerticalAlignment="Center" 
                       Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding SpecEq}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Внешнее состояние:" VerticalAlignment="Center" 
                       Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding ExternalCond}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Покрышки:" VerticalAlignment="Center" 
                       Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding NumberWheel}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Grid.Row="13" Grid.Column="0" Text="Топливо (л):" VerticalAlignment="Center" 
                       Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="13" Grid.Column="1" Text="{Binding FuelAvail}" Margin="2,0" Height="22" 
                     FontSize="11" Background="#3E3E42" Foreground="White"
                             PreviewTextInput="FuelValidationTextBox"/>

                    <TextBlock Grid.Row="14" Grid.Column="0" Text="Заключение:" FontWeight="Bold" 
                       VerticalAlignment="Top" Margin="2,0" FontSize="11" Foreground="#CCC"/>
                    <TextBox Grid.Row="14" Grid.Column="1" Text="{Binding Conclusion}" Margin="2,0" Height="40" 
                     TextWrapping="Wrap" AcceptsReturn="True" FontSize="11" 
                     Background="#3E3E42" Foreground="White"/>
                </Grid>
            </ScrollViewer>
        </GroupBox>
        
        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Сформировать акт" Command="{Binding GenerateCommand}"
                    Width="140" Height="30" Margin="4"
                    Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Отмена" Click="Cancel_Click"
                    Width="90" Height="30" Margin="4"
                    Background="#555" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>