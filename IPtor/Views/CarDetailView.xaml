<Window x:Class="IPtor.Views.CarDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация о машине" 
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBox">
            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold" Margin="0,0,0,10">
            <Run Text="{Binding Car.Name}" />
            <Run Text=" - " />
            <Run Text="{Binding Car.Number}" />
        </TextBlock>

        <!-- Вкладки -->
        <TabControl Grid.Row="1">
            <!-- Основная информация -->
            <TabItem Header="Основная информация">
                <ScrollViewer Margin="10">
                    <StackPanel>
                        <TextBlock Text="Наименование" FontWeight="Bold" />
                        <TextBox Text="{Binding Car.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Модель" FontWeight="Bold" />
                        <TextBox Text="{Binding Car.Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Гос. номер" FontWeight="Bold" />
                        <TextBox Text="{Binding Car.Number, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Наименование ТС" FontWeight="Bold" />
                        <TextBox Text="{Binding Car.ClassName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Служба" FontWeight="Bold" />
                        <ComboBox ItemsSource="{Binding ServiceTypes}"
                                  SelectedItem="{Binding Car.Service}"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="VIN" FontWeight="Bold" />
                        <TextBox Text="{Binding Car.Vin, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Свидетельство" FontWeight="Bold" />
                        <TextBox Text="{Binding Car.Certificate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Двигатель" FontWeight="Bold" />
                        <TextBox Text="{Binding Car.EngineNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Формуляр" FontWeight="Bold" />
                        <TextBox Text="{Binding Car.Formular, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Дата формуляра" FontWeight="Bold" />
                        <DatePicker SelectedDate="{Binding Car.FormularDate}" Margin="0,0,0,10" />

                        <TextBlock Text="Год выпуска" FontWeight="Bold" />
                        <TextBox Text="{Binding Car.Year, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Инвентарный номер" FontWeight="Bold" />
                        <TextBox Text="{Binding Car.InventoryNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Батареи -->
            <TabItem Header="Батареи">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" 
                     ItemsSource="{Binding Batteries}" 
                     SelectedItem="{Binding SelectedBattery}"
                     HorizontalContentAlignment="Stretch">          
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,5" Background="#F8F8F8" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="Марка" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding Specifications, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,5,0">
                                            <TextBlock Text="Ток" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding StartingCurrent, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0,0,5,0">
                                            <TextBlock Text="Полярность" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding Polarity, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="0,0,5,0">
                                            <TextBlock Text="Корпус" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding BodyType, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Дата установки" FontSize="10" Foreground="Gray"/>
                                            <DatePicker SelectedDate="{Binding InstallationDate}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Content="➕ Добавить" Command="{Binding AddBatteryCommand}" Padding="10,5" Margin="0,0,10,0" />
                        <Button Content="🗑 Удалить" Command="{Binding DeleteBatteryCommand}" Padding="10,5" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Шины -->
            <TabItem Header="Шины">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" 
                    ItemsSource="{Binding Tires}" 
                    SelectedItem="{Binding SelectedTire}"
                    HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,5" Background="#F8F8F8" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="Ширина" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,5,0">
                                            <TextBlock Text="Профиль" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding Profile, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0,0,5,0">
                                            <TextBlock Text="Диаметр" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding Diameter, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="0,0,5,0">
                                            <TextBlock Text="Марка" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Margin="0,0,5,0">
                                            <TextBlock Text="Модель" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="5">
                                            <TextBlock Text="Дата установки" FontSize="10" Foreground="Gray"/>
                                            <DatePicker SelectedDate="{Binding InstallationDate}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Content="➕ Добавить" Command="{Binding AddTireCommand}" Padding="10,5" Margin="0,0,10,0" />
                        <Button Content="🗑 Удалить" Command="{Binding DeleteTireCommand}" Padding="10,5" />
                    </StackPanel>
                </Grid>
            </TabItem>
            
            <!-- Дефекты -->
            <TabItem Header="Акты дефектовки">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="🔄 Обновить" Command="{Binding RefreshCommand}" 
                HorizontalAlignment="Left" Padding="5" Margin="0,0,0,5" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding Defects}"
                             SelectedItem="{Binding SelectedDefect}"
                             MouseDoubleClick="DefectsListBox_MouseDoubleClick"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,0,0,5" Background="#F8F8F8" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ActDate, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                       FontSize="10" Foreground="#999" />
                                        <TextBlock Text="{Binding Conclusion}" FontWeight="Bold" FontSize="13" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Staff}" Foreground="#666" FontSize="11" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ТО -->
            <TabItem Header="Акты ТО">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="🔄 Обновить" Command="{Binding RefreshCommand}" 
                HorizontalAlignment="Left" Padding="5" Margin="0,0,0,5" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding DefectsTO}"
                             SelectedItem="{Binding SelectedDefectTO}"
                             MouseDoubleClick="TOListBox_MouseDoubleClick"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,0,0,5" Background="#F8F8F8" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ActDate, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                       FontSize="10" Foreground="#999" />
                                        <TextBlock Text="{Binding Zakl}" FontWeight="Bold" FontSize="13" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Pred}" Foreground="#666" FontSize="11" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding GeneralView}" FontSize="11" Foreground="#999" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Кнопка сохранения -->
        <Button Grid.Row="2"
                Content="💾 Сохранить"
                Command="{Binding SaveCommand}"
                Padding="15,8"
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                Background="#4CAF50"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand" />
    </Grid>
</Window>