<UserControl x:Class="IPtor.Views.EquipmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style TargetType="TextBox">
            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <WrapPanel>
                <TextBlock Text="Служба:" VerticalAlignment="Center" Margin="0,0,5,0" />
                <ComboBox ItemsSource="{Binding ServiceTypes}"
                  SelectedItem="{Binding SelectedServiceFilter}"
                  Width="130" Margin="0,0,10,0" />

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                 Width="100" Height="26" Margin="0,0,5,0"
                 VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="🔍" ToolTip="Поиск" Command="{Binding SearchCommand}"
                Width="30" Height="26" Margin="0,0,10,0" />

                <Button Content="🔄" ToolTip="Обновить" Command="{Binding LoadEquipmentCommand}"
                Width="30" Height="26" Margin="0,0,5,0" />
                <Button Content="🗑" ToolTip="Удалить" Command="{Binding DeleteEquipmentCommand}"
                Width="30" Height="26" Margin="0,0,5,0" />
                <Button Content="ℹ️" ToolTip="Подробно" Command="{Binding OpenEquipmentDetailCommand}"
                Width="30" Height="26" Margin="0,0,5,0" />
            </WrapPanel>
        </StackPanel>

        <!-- Список оборудования -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Equipment}"
                 SelectedItem="{Binding SelectedEquipment}"
                  MouseDoubleClick="ListBox_MouseDoubleClick"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,2" Background="#F8F8F8" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="Bold" FontSize="14">
                                    <Run Text="{Binding Name}" />
                                    <Run Text="{Binding Model}" />
                                </TextBlock>
                                <TextBlock Text="{Binding SerialNumber}" Foreground="Gray" />
                                <TextBlock Text="{Binding ClassName}" FontSize="12" Foreground="#666" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Service}" Foreground="#007ACC" FontWeight="Bold" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding BoxNumber, StringFormat='Ящик №{0}'}" FontSize="11" Foreground="Gray" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Форма добавления -->
        <Border Grid.Row="2" Background="#F0F4F8" Padding="15" Margin="0,10,0,0" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Добавить оборудование" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />

                <WrapPanel>
                    <StackPanel Margin="0,0,10,5" Width="120">
                        <TextBlock Text="Наименование" FontSize="11" Foreground="Gray" />
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,10,5" Width="120">
                        <TextBlock Text="Модель" FontSize="11" Foreground="Gray" />
                        <TextBox Text="{Binding NewModel, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,10,5" Width="120">
                        <TextBlock Text="Класс" FontSize="11" Foreground="Gray" />
                        <TextBox Text="{Binding NewClassName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,10,5" Width="120">
                        <TextBlock Text="Серийный номер" FontSize="11" Foreground="Gray" />
                        <TextBox Text="{Binding NewSerialNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,10,5" Width="120">
                        <TextBlock Text="Служба" FontSize="11" Foreground="Gray" />
                        <ComboBox ItemsSource="{Binding ServiceTypes}"
                                  SelectedItem="{Binding NewService}" />
                    </StackPanel>
                </WrapPanel>

                <WrapPanel Margin="0,5,0,0">
                    <StackPanel Margin="0,0,10,5" Width="90">
                        <TextBlock Text="Формуляр" FontSize="11" Foreground="Gray" />
                        <TextBox Text="{Binding NewFormular, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,10,5" Width="90">
                        <TextBlock Text="Год" FontSize="11" Foreground="Gray" />
                        <TextBox Text="{Binding NewYear, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,10,5" Width="120">
                        <TextBlock Text="Инв. номер" FontSize="11" Foreground="Gray" />
                        <TextBox Text="{Binding NewInventoryNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,10,5" Width="90">
                        <TextBlock Text="Ящик" FontSize="11" Foreground="Gray" />
                        <TextBox Text="{Binding NewBoxNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Button Content="➕ Добавить" Command="{Binding AddEquipmentCommand}"
                            Padding="15,8" Margin="0,15,0,0"
                            Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>