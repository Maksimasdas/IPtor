<UserControl x:Class="IPtor.Views.RepairRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <WrapPanel>
                <Button Content="🔄" ToolTip="Обновить" Command="{Binding LoadRequestsCommand}"
                        Width="35" Height="30" Margin="0,0,5,0" />
                <Button Content="✏️" ToolTip="Редактировать заявку" Command="{Binding EditRequestCommand}"
                        Width="35" Height="30" Margin="0,0,5,0" />
                <Button Content="🗑" ToolTip="Удалить заявку" Command="{Binding DeleteRequestCommand}"
                        Width="35" Height="30" Margin="0,0,5,0" />
                <Button Content="🔧" ToolTip="Принять в ремонт" Command="{Binding AcceptForRepairCommand}"
                        Width="35" Height="30" Margin="0,0,5,0" />
            </WrapPanel>

            <!-- Фильтр по машине -->
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="Поиск машины для фильтра:" FontSize="11" Foreground="Gray" />
                <TextBox Text="{Binding CarSearchText, UpdateSourceTrigger=PropertyChanged}" 
             Margin="0,0,0,5" />

                <TextBlock Text="Фильтр по машине:" FontSize="11" Foreground="Gray" />
                <ComboBox ItemsSource="{Binding Cars}"
              SelectedItem="{Binding SelectedCarFilter}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontWeight="Bold">
                        <Run Text="{Binding Name}" />
                        <Run Text=" - " />
                        <Run Text="{Binding Number}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Model}" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- Список заявок -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Requests}"
                 SelectedItem="{Binding SelectedRequest}"
                 MouseDoubleClick="ListBox_MouseDoubleClick"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,2" Background="#F8F8F8" CornerRadius="4">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" FontSize="13">
                                <Run Text="{Binding Car.Name}" />
                                <Run Text=" - " />
                                <Run Text="{Binding Car.Number}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Description}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RequestDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                                       FontSize="10" Foreground="#666" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>