<UserControl x:Class="IPtor.Views.RepairsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="🔄" ToolTip="Обновить" Command="{Binding LoadRepairsCommand}"
                    Width="35" Height="30" Margin="0,0,5,0" />
            <Button Content="✅" ToolTip="Выпустить из ремонта" Command="{Binding ReleaseFromRepairCommand}"
                    Width="35" Height="30" Margin="0,0,5,0" />
            <Button Content="📋" ToolTip="Открыть акт дефектовки" Command="{Binding OpenRepairActCommand}"
                    Width="35" Height="30" Margin="0,0,5,0" />
        </StackPanel>

        <!-- Список машин в ремонте -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Repairs}"
                 SelectedItem="{Binding SelectedRepair}"
                 MouseDoubleClick="ListBox_MouseDoubleClick"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,2" Background="#FFF3E0" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="Bold" FontSize="14">
                                    <Run Text="{Binding Name}" />
                                    <Run Text="{Binding Model}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Number}" Foreground="Gray" />
                                <TextBlock Text="{Binding RepairReason}" 
                                   Foreground="#E65100" 
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                                <TextBlock Text="{Binding RepairStartDate, StringFormat='В ремонте с {0:dd.MM.yyyy HH:mm}'}" 
                                   Foreground="#999" 
                                   FontSize="10"
                                   Margin="0,3,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="🔧 В ремонте"
                                       VerticalAlignment="Center"
                                       Foreground="#E65100"
                                       FontWeight="Bold" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>