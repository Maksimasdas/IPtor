<Window x:Class="IPtor.Views.SetRepairReasonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отправить в ремонт" 
        Height="250" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#2D2D30">

    <Window.Resources>
        <Style TargetType="TextBox">
            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Укажите причину отправки в ремонт:" 
                   Foreground="White" 
                   FontWeight="Bold" 
                   Margin="0,0,0,10" />

        <TextBox Grid.Row="1"
                 Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Background="#3E3E42" 
                 Foreground="White" />

        <Button Grid.Row="2"
                Content="💾 Отправить в ремонт"
                Command="{Binding SaveCommand}"
                Padding="15,8"
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                Background="#FF9800"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand" />
    </Grid>
</Window>