<Window x:Class="IPtor.Views.AddRepairRequestView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая заявка на ремонт" 
        Height="300" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="#2D2D30">

    <Window.Resources>
        <Style TargetType="TextBox">
            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#3E3E42" Padding="8" Margin="0,0,0,10" CornerRadius="4">
            <TextBlock Text="{Binding CarInfo}" FontSize="14" FontWeight="Bold" Foreground="White"/>
        </Border>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Описание неисправности" Foreground="#CCC" FontWeight="Bold" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Height="100"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Background="#3E3E42" Foreground="White" />
        </StackPanel>

        <Button Grid.Row="2"
                Content="💾 Сохранить"
                Command="{Binding SaveCommand}"
                Padding="15,8"
                HorizontalAlignment="Right"
                Background="#4CAF50"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand" />
    </Grid>
</Window>