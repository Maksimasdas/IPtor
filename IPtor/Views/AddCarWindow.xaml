<Window x:Class="IPtor.Views.AddCarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить машину" 
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- Вкладка: Основное -->
            <TabItem Header="Основная информация">
                <ScrollViewer Margin="10">
                    <StackPanel>
                        <TextBlock Text="Наименование" FontWeight="Bold" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Модель" FontWeight="Bold" />
                        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Гос. номер" FontWeight="Bold" />
                        <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Класс" FontWeight="Bold" />
                        <TextBox Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Служба" FontWeight="Bold" />
                        <ComboBox ItemsSource="{Binding ServiceTypes}"
                                  SelectedItem="{Binding SelectedService}"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="VIN" FontWeight="Bold" />
                        <TextBox Text="{Binding Vin, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Свидетельство" FontWeight="Bold" />
                        <TextBox Text="{Binding Certificate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Двигатель" FontWeight="Bold" />
                        <TextBox Text="{Binding EngineNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Формуляр" FontWeight="Bold" />
                        <TextBox Text="{Binding Formular, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Дата формуляра" FontWeight="Bold" />
                        <DatePicker SelectedDate="{Binding FormularDate}" Margin="0,0,0,10" />

                        <TextBlock Text="Год" FontWeight="Bold" />
                        <TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Инв. номер" FontWeight="Bold" />
                        <TextBox Text="{Binding InventoryNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка: Батареи -->
            <TabItem Header="Батареи">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" 
                             ItemsSource="{Binding Batteries}" 
                             SelectedItem="{Binding SelectedBattery}"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,5" Background="#F8F8F8" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="Модель" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding Specifications, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,5,0">
                                            <TextBlock Text="Ток" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding StartingCurrent, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0,0,5,0">
                                            <TextBlock Text="Полярность" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding Polarity, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="0,0,5,0">
                                            <TextBlock Text="Корпус" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding BodyType, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Дата" FontSize="10" Foreground="Gray"/>
                                            <DatePicker SelectedDate="{Binding InstallationDate}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Content="➕ Добавить" Command="{Binding AddBatteryCommand}" Padding="10,5" Margin="0,0,10,0" />
                        <Button Content="🗑 Удалить" Command="{Binding DeleteBatteryCommand}" Padding="10,5" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Вкладка: Шины -->
            <TabItem Header="Шины">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" 
                             ItemsSource="{Binding Tires}" 
                             SelectedItem="{Binding SelectedTire}"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,5" Background="#F8F8F8" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="Ширина" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,5,0">
                                            <TextBlock Text="Профиль" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding Profile, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0,0,5,0">
                                            <TextBlock Text="Диаметр" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding Diameter, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="0,0,5,0">
                                            <TextBlock Text="Марка" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Margin="0,0,5,0">
                                            <TextBlock Text="Модель" FontSize="10" Foreground="Gray"/>
                                            <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="5">
                                            <TextBlock Text="Дата" FontSize="10" Foreground="Gray"/>
                                            <DatePicker SelectedDate="{Binding InstallationDate}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Content="➕ Добавить" Command="{Binding AddTireCommand}" Padding="10,5" Margin="0,0,10,0" />
                        <Button Content="🗑 Удалить" Command="{Binding DeleteTireCommand}" Padding="10,5" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Кнопка сохранения -->
        <Button Grid.Row="1"
                Content="💾 Сохранить"
                Command="{Binding SaveCommand}"
                Padding="15,8"
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                Background="#4CAF50"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand" />
    </Grid>
</Window>