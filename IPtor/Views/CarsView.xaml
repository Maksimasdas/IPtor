<UserControl x:Class="IPtor.Views.CarsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="ScrollViewer">
            <Setter Property="CanContentScroll" Value="False"/>
        </Style>
        <!--<Style TargetType="ScrollViewer">
            <Setter Property="PanningMode" Value="VerticalOnly"/>
            <Setter Property="PanningDeceleration" Value="0.01"/>
            <Setter Property="PanningRatio" Value="0.01"/>
        </Style>-->
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: фильтр и кнопки -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Служба:" VerticalAlignment="Center" Margin="0,0,5,0" />
                <ComboBox ItemsSource="{Binding ServiceTypes}"
              SelectedItem="{Binding SelectedServiceFilter}"
              Width="130" Margin="0,0,10,0" />

                <TextBox Text="{Binding SearchNumber, UpdateSourceTrigger=PropertyChanged}" 
             Width="100" Height="26" Margin="0,0,5,0"
             VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="🔍" ToolTip="Поиск" Command="{Binding SearchCommand}"
            Width="30" Height="26" Margin="0,0,10,0" />

                <Button Content="🔄" ToolTip="Обновить" Command="{Binding LoadCarsCommand}"
            Width="30" Height="26" Margin="0,0,5,0" />
                <Button Content="➕" ToolTip="Добавить машину" Command="{Binding AddCarCommand}"
            Width="30" Height="26" Margin="0,0,5,0" />
                <Button Content="🗑" ToolTip="Удалить" Command="{Binding DeleteCarCommand}"
            Width="30" Height="26" Margin="0,0,5,0" />
                <Button Content="ℹ️" ToolTip="Подробно" Command="{Binding OpenCarDetailCommand}"
            Width="30" Height="26" Margin="0,0,5,0" />
                <Button Content="📋" ToolTip="Акт передачи" Command="{Binding CreateTransferActCommand}"
            Width="30" Height="26" Margin="0,0,5,0" />
                <Button Content="🛠" ToolTip="Акт тех. состояния" Command="{Binding CreateTOActCommand}"
            Width="30" Height="26" />
            </WrapPanel>
        </StackPanel>

        <!-- Список машин -->
        <ListBox Grid.Row="1" x:Name="CarsListBox"
                 ItemsSource="{Binding Cars}"
                 SelectedItem="{Binding SelectedCar}"
                 MouseDoubleClick="ListBox_MouseDoubleClick"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Создать заявку на ремонт" 
                      Command="{Binding CreateRepairRequestCommand}" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,2" Background="#F8F8F8" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock FontWeight="Bold" FontSize="14">
                                    <Run Text="{Binding Name}"/>
                                    <Run Text="{Binding Model}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Number}" Foreground="Gray" />
                                <TextBlock>
                                    <Run Text="VIN:" />
                                    <Run Text="{Binding Vin}" />
                                    <Run Text="| Год: " />
                                    <Run Text="{Binding Year}" />
                                </TextBlock>
                                <TextBlock Text="{Binding ClassName}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Service}"
                                       VerticalAlignment="Center"
                                       Foreground="#007ACC"
                                       FontWeight="Bold" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>