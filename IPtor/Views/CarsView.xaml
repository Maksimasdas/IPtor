<UserControl x:Class="IPtor.Views.CarsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: фильтр и кнопки -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Служба:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <ComboBox ItemsSource="{Binding ServiceTypes}"
              SelectedItem="{Binding SelectedServiceFilter}"
              Width="150" Margin="0,0,10,0" />

            <Button Content="🔄"
            ToolTip="Обновить"
            Command="{Binding LoadCarsCommand}"
            Width="35" Height="30" Margin="0,0,5,0" />

            <Button Content="➕"
            ToolTip="Добавить машину"
            Command="{Binding AddCarCommand}"
            Width="35" Height="30" Margin="0,0,5,0" />

            <Button Content="🗑"
            ToolTip="Удалить"
            Command="{Binding DeleteCarCommand}"
            Width="35" Height="30" Margin="0,0,5,0" />

            <Button Content="ℹ️"
            ToolTip="Подробно"
            Command="{Binding OpenCarDetailCommand}"
            Width="35" Height="30" Margin="0,0,5,0" />

            <Button Content="📋"
            ToolTip="Акт передачи"
            Command="{Binding CreateTransferActCommand}"
            Width="35" Height="30" Margin="0,0,5,0" />

            <Button Content="🛠"
            ToolTip="Акт тех. состояния"
            Command="{Binding CreateTOActCommand}"
            Width="35" Height="30" Margin="0,0,5,0" />  
        </StackPanel>

        <!-- Список машин -->
        <ListBox Grid.Row="1" x:Name="CarsListBox"
                 ItemsSource="{Binding Cars}"
                 SelectedItem="{Binding SelectedCar}"
                 MouseDoubleClick="ListBox_MouseDoubleClick"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Создать заявку на ремонт" 
                      Command="{Binding CreateRepairRequestCommand}" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,2" Background="#F8F8F8" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                                <TextBlock Text="{Binding Number}" Foreground="Gray" />
                                <TextBlock>
                                    <Run Text="Модель: " />
                                    <Run Text="{Binding Model}" />
                                    <Run Text=" | Год: " />
                                    <Run Text="{Binding Year}" />
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Service}"
                                       VerticalAlignment="Center"
                                       Foreground="#007ACC"
                                       FontWeight="Bold" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>