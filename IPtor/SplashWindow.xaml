<Window x:Class="IPtor.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузка" 
        WindowStyle="None" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Width="400" Height="200"
        Background="#2D2D30"
        ShowInTaskbar="False">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="IPtor" 
                       Foreground="White" 
                       FontSize="32" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Учёт автотранспорта" 
                       Foreground="#CCCCCC" 
                       FontSize="14" 
                       Margin="0,5,0,20"
                       HorizontalAlignment="Center"/>

            <!-- Бесконечно крутящийся прогрессбар -->
            <ProgressBar IsIndeterminate="True" 
                         Width="300" 
                         Height="10"
                         Foreground="#007ACC"
                         Background="#3E3E42"
                         BorderThickness="0"/>

            <TextBlock x:Name="StatusText"
                       Text="Запуск приложения..." 
                       Foreground="#999999" 
                       FontSize="11" 
                       Margin="0,15,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>