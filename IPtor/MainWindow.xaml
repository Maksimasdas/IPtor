<Window x:Class="IPtor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IPtor"
        xmlns:views="clr-namespace:IPtor.Views"
        xmlns:vm="clr-namespace:IPtor.ViewModels"
        mc:Ignorable="d"
        Title="IPtor - Учёт автотранспорта" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Icon="/Images/PriemOchka1.ico">
    <Window.Resources> 
        <!-- Когда CurrentView = CarsViewModel -> показать CarsView и т.д. -->
        <DataTemplate DataType="{x:Type vm:CarsViewModel}">
            <views:CarsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PersonsViewModel}">
            <views:PersonsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RepairRequestsViewModel}">
            <views:RepairRequestsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <views:StatisticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RepairsViewModel}">
            <views:RepairsView />
        </DataTemplate>

    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <!-- Панель навигации -->
            <ColumnDefinition Width="*" />
            <!-- Контент -->
        </Grid.ColumnDefinitions>

        <!-- Левая панель — кнопки навигации -->
        <StackPanel Grid.Column="0"
                    Background="#2D2D30"
                    VerticalAlignment="Stretch">

            <!-- Заголовок -->
            <TextBlock Text="IPtor"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="15,20,15,30" />

            <!-- Кнопка "Машины" -->
            <Button Content="🚗 Машины"
                    Command="{Binding ShowCarsCommand}"
                    Margin="10,5"
                    Padding="10,8"
                    Background="#3E3E42"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand" />

            <!-- Кнопка "Сотруднки" -->
            <Button Content="👥 Сотрудники"
                    Command="{Binding ShowPersonsCommand}"
                    Margin="10,5"
                    Padding="10,8"
                    Background="#3E3E42"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand" />

            <!-- Кнопка заявки" -->
            <Button Content="🔧 Заявки"
                    Command="{Binding ShowRepairRequestsCommand}"
                    Margin="10,5"
                    Padding="10,8"
                    Background="#3E3E42"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand" />

            <!-- Кнопка "В ремонте" -->
            <Button Content="🔧 В ремонте"
                Command="{Binding ShowRepairsCommand}"
                Margin="10,5"
                Padding="10,8"
                Background="#3E3E42"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand" />

            <!-- кнопка статистики -->
            <Button Content="📊 Статистика"
                Command="{Binding ShowStatisticsCommand}"
                Margin="10,5"
                Padding="10,8"
                Background="#3E3E42"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand" />
            
        </StackPanel>

        <!-- Правая часть — контент (меняется через привязку) -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"
                        Margin="15" />
    </Grid>
</Window>
